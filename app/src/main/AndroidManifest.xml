<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voice input for the assistant only: requested at first mic tap, never at launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Direct in-app update install (0.32.0): granted once, at first use, from the
         system «install unknown apps» settings — never requested at launch. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Prayer alarms are a core function of this app: they must fire at the calculated time. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Allows listing launchable apps without the restricted QUERY_ALL_PACKAGES permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".FocusApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FocusStudy">

        <!-- Hotfix 0.33.1: ML Kit's auto-init provider (MlKitInitProvider) runs
             before Application.onCreate and crashed the app at startup on some
             devices (instant exit, no UI at all). It is removed here; ML Kit is
             initialized lazily in FaceAnalyzer before the first face detection
             instead, so no ML Kit code runs at app startup. -->
        <provider
            android:name="com.google.mlkit.common.internal.MlKitInitProvider"
            android:authorities="${applicationId}.mlkitinitprovider"
            tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Launched by the adhan notification's full-screen intent so the alert is visible on the lock screen. -->
        <!-- singleTop: a second launch of the alert already on screen (direct alarm plus the
             notification's full-screen intent) is delivered to this instance via onNewIntent
             instead of stacking a copy — and a later prayer replaces the one on screen. -->
        <activity
            android:name=".PrayerAlertActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:label="@string/prayer_alert_label"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.FocusStudy" />

        <!-- Keeps the selected adhan playing at alarm volume even if the alert screen is closed
             or another notification arrives. Its ongoing notification is silent and ongoing. -->
        <service
            android:name=".AdhanPlaybackService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Plays the locally packaged adhan as an alarm at the exact prayer time" />
        </service>

        <service
            android:name=".BlockVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local firewall that drops network traffic of user-selected apps during a focus session" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Optional: suspends selected apps when the app is provisioned as Device Owner. -->
        <receiver
            android:name=".FocusDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:exported="true"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Wakes the app at the end time so a locked session always releases its apps. -->
        <receiver
            android:name=".SessionEndReceiver"
            android:exported="false" />

        <receiver
            android:name=".DailyReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".PrayerReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".DhikrReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".WirdReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".SkillReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".ExerciseReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".AssistantFollowUpReceiver"
            android:exported="false" />
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".ReminderActionReceiver"
            android:exported="false" />



        <receiver
            android:name=".AppUpdateReceiver"
            android:exported="false" />

        <service
            android:name=".ReminderRescheduleJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".NetworkRetryJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".FocusBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".AppBlockAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Phase 7b: shares the private copies of support images (filesDir) with
             WhatsApp — filesDir is invisible to other apps, so the copies go out
             through FileProvider. No other path is exposed. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
